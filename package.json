{
	"name": "one-sudoku",
	"version": "0.1.0",
	"description": "",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tsgo": "svelte-kit sync && svelte-check --incremental --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check . && oxlint && eslint .",
		"format": "oxfmt --write .",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"tauri": "tauri",
		"test": "vitest run",
		"screenshots": "pnpm --filter @one-sudoku/scripts screenshots",
		"gen:icon": "tauri icon ./app-icon.json"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-store": "^2.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.14.0",
		"eslint-plugin-oxlint": "~1.90.0",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"oxfmt": "^0.77.0",
		"oxlint": "~1.90.0",
		"postcss": "^8.5.32",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.18.0"
}
