{
	"productName": "one-sudoku",
	"version": "0.0.0",
	"identifier": "nl.schelpkikker.dev",
	"build": {
		"beforeDevCommand": "pnpm dev --host",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "One Sudoku",
				"width": 800,
				"height": 600,
				"center": true,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
